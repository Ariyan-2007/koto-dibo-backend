<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\KotoDibo.Application\KotoDibo.Application.csproj" />
    <ProjectReference Include="..\KotoDibo.Domain\KotoDibo.Domain.csproj" />
    <ProjectReference Include="..\KotoDibo.Common\KotoDibo.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Gives this non-Web class library access to ASP.NET Core abstractions (IHttpContextAccessor,
         HttpContext) from the shared framework, matching the runtime version instead of pulling in
         the old standalone compat package. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.102.4" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="MongoDB.Driver" Version="3.10.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
